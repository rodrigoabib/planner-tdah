# -------- PostHog (DATA-1 / DATA-2) --------
# Project API Key (público no front-end — não é segredo)
# Pegar em https://app.posthog.com → Project → Settings → Project API Key
VITE_POSTHOG_KEY=

# Host do PostHog. US Cloud (default) ou EU Cloud (https://eu.i.posthog.com)
VITE_POSTHOG_HOST=https://us.i.posthog.com

# -------- Meta Pixel (ACQ-7 — KAN-40, ainda não implementado) --------
# Pixel ID (16 dígitos) criado no Gerenciador de Eventos
# VITE_META_PIXEL_ID=
